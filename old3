 document.getElementById('modal-speech-preview').innerHTML = speech ? `<div class="text-[11px] text-cyan-300/90 bg-cyan-950/40 p-2.5 rounded border border-cyan-800/40 space-y-1"><span class="font-semibold text-cyan-400 block uppercase tracking-wider text-[10px]">Mluvené slovo v tomto úseku (AI):</span><div class="italic">"${escapeHtml(speech)}"</div></div>` : `<div class="text-[11px] text-slate-500 italic">Pro tento úsek není k dispozici přepis.</div>`;
