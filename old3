 item.type === 'jingle' ? '<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-2v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12 0c0 1.105-1.343 2-3 2s-3-.895-3-2 3 .895 3 2zM9 10l12-2"></path></svg> Znělka</span>' :
 '<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-semibold bg-purple-500/20 text-purple-400 border border-purple-500/30"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 v8a2 2 0 01-2 2h-3l-4 4z"></path></svg> Poznámka</span>';

 const speech = isFixedItem(item) ? '' : getSpeechInTimeRange(item.timeInSeconds, item.timeOutSeconds);
 const timeDisplay = item.timeOut ? `${item.timeIn} – ${item.timeOut}` : item.timeIn;

 tr.innerHTML = `
 <td class="py-3 px-4 text-center text-xs font-mono text-slate-500">${idx + 1}</td>
 <td class="py-3 px-4 font-mono font-semibold text-studio-accent text-xs">
 <button onclick="seekToTime(${item.timeInSeconds})" class="hover:underline flex items-center gap-1" title="Přehrát"><svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-studio-accent" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>${timeDisplay}</button>
 </td>
 <td class="py-3 px-4">${badge}</td>
 <td class="py-3 px-4">
 <div class="font-semibold text-slate-200 text-xs">${item.category}</div>
 <div class="text-slate-300 text-xs mt-0.5 leading-relaxed font-medium font-mono">${escapeHtml(item.instruction || 'Bez pokynu')}</div>
 ${speech ? `<div class="mt-1.5 text-[11px] text-cyan-300/80 italic bg-slate-900/60 p-2 rounded border border-slate-800/80 flex items-start gap-1"><span class="font-semibold not-italic text-slate-500 flex-shrink-0">Slova:</span> "${escapeHtml(speech)}"</div>` : ''}
 </td>
 <td class="py-3 px-4 text-right">
 <div class="flex items-center justify-end gap-1">
 <button onclick="editItem('${item.id}')" class="p-1.5 text-slate-400 hover:text-white hover:bg-slate-800 rounded transition" title="Upravit"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg></button>
 <button onclick="deleteItem('${item.id}')" class="p-1.5 text-slate-400 hover:text-rose-400 hover:bg-slate-800 rounded transition" title="Smazat"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg></button>
 </div>
 </td>`;
 tbody.appendChild(tr);
 });
 highlightCurrentTranscriptRow();
 }

 function highlightCurrentTranscriptRow() {
 if (!audioPlayer) return;
 const curTime = audioPlayer.currentTime || 0;
 document.querySelectorAll('.protocol-row').forEach(row => {
 row.classList.toggle('highlight-active-row', Math.abs(curTime - parseFloat(row.dataset.time || 0)) < 1.5);
 });
 }

 function getProjectHeaderMeta() {
 return {
 title: document.getElementById('meta-title').value || 'Bez názvu',
 author: document.getElementById('meta-author').value || 'Neuveden',
 notes: document.getElementById('meta-notes').value || 'Bez poznámky'
 };
 }

 function saveMetadata() { saveStateToStorage(); }

 function copyForExcel() {
 const meta = getProjectHeaderMeta();
 let tsv = `STŘIHOVÝ PROTOKOL PODCASTU (v5.1)\nNázev epizody:\t${meta.title}\nAutor/Střihač:\t${meta.author}\nPoznámka:\t${meta.notes}\n\n#\tČasový kód\tTyp\tKategorie\tPokyn zvukařovi\tMluvené slovo v úseku (AI)\n`;
 userMarkers.forEach((item, idx) => {
 const speech = isFixedItem(item) ? '' : getSpeechInTimeRange(item.timeInSeconds, item.timeOutSeconds);
 tsv += `${idx + 1}\t${item.timeOut ? `${item.timeIn} – ${item.timeOut}` : item.timeIn}\t${item.type.toUpperCase()}\t${item.category}\t${(item.instruction || '').replace(/\n/g, ' ')}\t${speech.replace(/\n/g, ' ')}\n`;
 });
 copyToClipboard(tsv, 'Tabulka zkopírována do schránky (vložte Ctrl+V do Excelu).');
 }

 function downloadCSV() {
 const meta = getProjectHeaderMeta();
 let csv = '\uFEFF"STŘIHOVÝ PROTOKOL PODCASTU (v5.1)"\n' + `"Název epizody:","${meta.title.replace(/"/g, '""')}"\n` + `"Autor/Střihač:","${meta.author.replace(/"/g, '""')}"\n` + `"Poznámka:","${meta.notes.replace(/"/g, '""')}"\n\n` + `"Číslo","Časový kód","Typ","Kategorie","Pokyn zvukařovi","Mluvená slova v úseku"\n`;
 userMarkers.forEach((item, idx) => {
 const speech = isFixedItem(item) ? '' : getSpeechInTimeRange(item.timeInSeconds, item.timeOutSeconds);
 csv += `"${idx + 1}","${item.timeOut ? `${item.timeIn} – ${item.timeOut}` : item.timeIn}","${item.type.toUpperCase()}","${item.category.replace(/"/g, '""')}","${(item.instruction || '').replace(/"/g, '""')}","${speech.replace(/"/g, '""')}"\n`;
 });
 const link = document.createElement('a');
 link.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
 link.download = `Protocol_${meta.title.replace(/[^a-z0-9]/gi, '_').toLowerCase()}.csv`;
 link.click(); showToast('Soubor CSV stažen.');
 }

 function downloadReaperCSV() {
 const meta = getProjectHeaderMeta();
 let csv = '#,Name,Start,End\r\n';
 const sortedMarkers = [...userMarkers].sort((a, b) => (a.orderPriority || 500) - (b.orderPriority || 500) || (a.timeInSeconds || 0) - (b.timeInSeconds || 0));
 let markerIndex = 1, regionIndex = 1;

 sortedMarkers.forEach((item, idx) => {
 const isRegion = item.type === 'cut' || (item.category && item.category.toLowerCase().includes('highlight'));
 const mNum = (item.isFixedEnd || item.id === 'fixed_outro') ? 'M999' : isRegion ? `R${regionIndex++}` : `M${markerIndex++}`;
 let name = (idx === 0 && (item.isFixedStart || item.id === 'fixed_trigger_warning' || item.id === 'fixed_intro')) ? '=START' : (item.isFixedEnd || item.id === 'fixed_outro') ? '=END' : `[${item.type === 'cut' ? 'STŘIH' : item.type === 'jingle' ? 'ZNĚLKA' : 'POZNÁMKA'}] ${item.instruction ? `${item.category} - ${item.instruction}` : item.category}`.trim();

 if (name.includes(',') || name.includes('"')) name = `"${name.replace(/"/g, '""')}"`;
 const startTime = formatReaperTime(item.timeInSeconds || 0);
 const endTime = isRegion ? formatReaperTime(item.timeOutSeconds || item.timeInSeconds || 0) : '';

 csv += `${mNum},${name},${startTime},${endTime}\r\n`;
 });

 const link = document.createElement('a');
 link.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
 link.download = `Reaper_Markers_${meta.title.replace(/[^a-z0-9]/gi, '_').toLowerCase()}.csv`;
 link.click();
 showToast('REAPER CSV značky a regiony byly úspěšně staženy.');
 }

 function formatReaperTime(s) {
 if (isNaN(s) || s < 0) return '00:00:00:00';
 const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = Math.floor(s % 60), frames = Math.floor((s % 1) * 25);
 return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}:${String(frames).padStart(2, '0')}`;
 }

 function copyMarkdown() {
 const meta = getProjectHeaderMeta();
 let md = `# Střihový protokol (v5.1): ${meta.title}\n**Autor:** ${meta.author} \n**Poznámka:** ${meta.notes}\n\n| # | Časový kód | Typ | Pokyn / Mluvená slova |\n|---|---|---|---|\n`;
 userMarkers.forEach((item, idx) => {
 const speech = isFixedItem(item) ? '' : getSpeechInTimeRange(item.timeInSeconds, item.timeOutSeconds);
 md += `| ${idx + 1} | \`${item.timeOut ? `${item.timeIn} – ${item.timeOut}` : item.timeIn}\` | **${item.category}** | ${item.instruction || ''}${speech ? ` *(Slova: "${speech}")*` : ''} |\n`;
 });
 copyToClipboard(md, 'Markdown zkopírován do schránky.');
 }

 function saveProjectJSON() {
 const meta = getProjectHeaderMeta();
 const link = document.createElement('a');
 link.href = URL.createObjectURL(new Blob([JSON.stringify({ meta, userMarkers, transcriptSegments, version: '5.1', savedAt: new Date().toISOString() }, null, 2)], { type: 'application/json' }));
 link.download = `Podcast_Project_${meta.title.replace(/[^a-z0-9]/gi, '_').toLowerCase()}.json`;
 link.click(); showToast('Projekt uložen do JSON souboru.');
 }

 function loadProjectJSON(e) {
 const file = e.target.files?.[0]; if (!file) return;
 const reader = new FileReader();
 reader.onload = (ev) => {
 try {
 const data = JSON.parse(ev.target.result);
 if (data.meta) {
 document.getElementById('meta-title').value = data.meta.title || '';
 document.getElementById('meta-author').value = data.meta.author || '';
 document.getElementById('meta-notes').value = data.meta.notes || '';
 }
 if (data.userMarkers) userMarkers = data.userMarkers;
 if (data.transcriptSegments) transcriptSegments = data.transcriptSegments;
 saveStateToStorage(); renderTable(); drawWaveform(); showToast('Projekt načten ze souboru JSON.');
 } catch (err) { showToast('Chyba při čtení JSON souboru.'); }
 };
 reader.readAsText(file);
 }

 function saveStateToStorage() {
 try { localStorage.setItem('podcast_editor_state_v5', JSON.stringify({ meta: getProjectHeaderMeta(), userMarkers, transcriptSegments })); } catch (e) {}
 }

 function loadStateFromStorage() {
 try {
 const saved = localStorage.getItem('podcast_editor_state_v5') || localStorage.getItem('podcast_editor_state_v4');
 if (saved) {
 const parsed = JSON.parse(saved);
 if (parsed.meta) {
 document.getElementById('meta-title').value = parsed.meta.title || '';
 document.getElementById('meta-author').value = parsed.meta.author || '';
 document.getElementById('meta-notes').value = parsed.meta.notes || '';
 }
 if (parsed.userMarkers) userMarkers = parsed.userMarkers;
 if (parsed.transcriptSegments) transcriptSegments = parsed.transcriptSegments;
 }
 } catch (e) {}
 }

 function resetProjectData() {
 if (confirm('Opravdu chcete vymazat všechna data střihového protokolu a načíst výchozí šablonu?')) {
 userMarkers = createDefaultMarkers(audioBuffer?.duration || 0);
 transcriptSegments = []; pendingCutIn = null;
 ['meta-title', 'meta-author', 'meta-notes'].forEach(id => document.getElementById(id).value = '');
 localStorage.removeItem('podcast_editor_state_v5');
 updateCutPendingBanner(); renderTable(); drawWaveform(); showToast('Projekt byl resetován na výchozí šablonu.');
 }
 }

 function copyToClipboard(text, successMsg) {
 if (navigator.clipboard?.writeText) {
 navigator.clipboard.writeText(text).then(() => showToast(successMsg)).catch(() => showToast('Chyba při kopírování.'));
 } else {
 const ta = document.createElement('textarea'); ta.value = text; ta.style.cssText = 'position:fixed;opacity:0';
 document.body.appendChild(ta); ta.select();
 try { document.execCommand('copy'); showToast(successMsg); } catch (e) { showToast('Chyba při kopírování.'); }
 document.body.removeChild(ta);
 }
 }

 function setupKeyboardShortcuts() {
 window.addEventListener('keydown', (e) => {
 if (['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName)) return;
 if (e.code === 'Space') { e.preventDefault(); togglePlay(); }
 else if (e.code === 'ArrowLeft') { e.preventDefault(); seekRelative(-3); }
 else if (e.code === 'ArrowRight') { e.preventDefault(); seekRelative(3); }
 else if (e.code === 'KeyC') { e.preventDefault(); handleCutButtonClick(); }
 else if (e.code === 'KeyY' || e.key.toLowerCase() === 'y' || e.key.toLowerCase() === 'z') { e.preventDefault(); openJingleModal(); }
 else if (e.code === 'KeyM') { e.preventDefault(); openNoteModal(); }
 });
 }

 function toggleShortcutsModal() { document.getElementById('modal-shortcuts').classList.toggle('hidden'); }

 function formatFormattedTime(s) {
 if (isNaN(s) || s < 0) return '00:00:00';
 const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = Math.floor(s % 60), ms = Math.floor((s % 1) * 10);
 return `${h > 0 ? String(h).padStart(2, '0') + ':' : ''}${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}.${ms}`;
 }

 function parseFormattedTime(str) {
 if (!str) return 0;
 const parts = str.trim().split(':');
 if (parts.length === 3) return parseFloat(parts[0]) * 3600 + parseFloat(parts[1]) * 60 + parseFloat(parts[2]);
 if (parts.length === 2) return parseFloat(parts[0]) * 60 + parseFloat(parts[1]);
 return parseFloat(str) || 0;
 }

 function showToast(msg) {
 const toast = document.getElementById('toast');
 document.getElementById('toast-message').innerText = msg;
 toast.classList.remove('translate-y-20', 'opacity-0');
 toast.classList.add('translate-y-0', 'opacity-100');
 setTimeout(() => { toast.classList.remove('translate-y-0', 'opacity-100'); toast.classList.add('translate-y-20', 'opacity-0'); }, 3000);
 }

 function escapeHtml(str) {
 return str ? str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;") : '';
 }
