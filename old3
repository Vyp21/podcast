 <script>
 let audioPlayer, audioContext, audioBuffer, rawPcmData, userMarkers = [], transcriptSegments = [], pendingCutIn = null, activeFilter = 'all', searchQuery = '', aiTimerInterval = null, wakeLockObj = null;

 const isFixedItem = m => m.isFixedStart || m.isFixedEnd || m.id?.toString().startsWith('fixed_');

 const createDefaultMarkers = (dur = 0) => [
 { id: 'fixed_trigger_warning', type: 'note', timeIn: '00:00:00', timeOut: '', timeInSeconds: 0, timeOutSeconds: null, category: 'Trigger warning', instruction: 'Vložit / Zkontrolovat Trigger Warning', isFixedStart: true, orderPriority: 1 },
 { id: 'fixed_intro', type: 'jingle', timeIn: '00:00:00', timeOut: '', timeInSeconds: 0.001, timeOutSeconds: null, category: 'Úvodní znělka / Intro', instruction: 'Jingle_INTRO.wav', isFixedStart: true, orderPriority: 2 },
 { id: 'fixed_loop', type: 'jingle', timeIn: '00:00:00', timeOut: '', timeInSeconds: 0.002, timeOutSeconds: null, category: 'Highlighty loop', instruction: 'Jingle_LOOP.wav', isFixedStart: true, orderPriority: 3 },
 { id: 'fixed_outro', type: 'jingle', timeIn: dur > 0 ? formatFormattedTime(dur) : 'KONEC', timeOut: '', timeInSeconds: dur > 0 ? dur : 999999, timeOutSeconds: null, category: 'Závěrečná znělka / Outro', instruction: 'Jingle_OUTRO.wav', isFixedEnd: true, orderPriority: 999 }
 ];

 window.addEventListener('load', () => {
 audioPlayer = document.getElementById('audio-player');
 setupAudioEventListeners(); setupDropzone(); setupKeyboardShortcuts(); setupModalEnterHandler(); loadStateFromStorage();
 if (!userMarkers.length) userMarkers = createDefaultMarkers(0);
 document.getElementById('waveform-canvas')?.addEventListener('click', handleCanvasClick);
 updateAiEstimate(); renderTable(); drawWaveform();
 });

 function handleFileSelect(e) {
 const files = e.target.files || e.dataTransfer?.files;
 if (files?.[0]) loadAudioFile(files[0]);
 }

 function setupDropzone() {
 const dropzone = document.getElementById('upload-zone');
 if (!dropzone) return;
 ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(ev => {
 dropzone.addEventListener(ev, (e) => {
 e.preventDefault(); e.stopPropagation();
 const active = ev === 'dragenter' || ev === 'dragover';
 dropzone.classList.toggle('border-studio-accent', active);
 dropzone.classList.toggle('bg-slate-800/80', active);
 if (ev === 'drop') handleFileSelect(e);
 });
 });
 }

 function setupModalEnterHandler() {
 document.getElementById('item-form').addEventListener('keydown', (e) => {
 if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); handleFormSubmit(e); }
 });
 }

 function loadAudioFile(file) {
 document.getElementById('upload-zone').classList.add('hidden');
 document.getElementById('player-container').classList.remove('hidden');
 document.getElementById('canvas-loading').classList.remove('hidden');
 document.getElementById('audio-file-name').innerText = file.name;
 audioPlayer.src = URL.createObjectURL(file);

 const reader = new FileReader();
 reader.onload = async (e) => {
 try {
 audioContext = audioContext || new (window.AudioContext || window.webkitAudioContext)();
 audioBuffer = await audioContext.decodeAudioData(e.target.result);
 extractWaveformPeaks(audioBuffer);
 document.getElementById('canvas-loading').classList.add('hidden');
 document.getElementById('time-total').innerText = formatFormattedTime(audioBuffer.duration);

 const outroItem = userMarkers.find(m => m.id === 'fixed_outro' || m.category === 'Závěrečná znělka / Outro');
 if (outroItem) { outroItem.timeInSeconds = audioBuffer.duration; outroItem.timeIn = formatFormattedTime(audioBuffer.duration); }
 updateAiEstimate(); saveStateToStorage(); renderTable(); drawWaveform(); showToast('Audio bylo úspěšně načteno.');
 } catch (err) { document.getElementById('canvas-loading').innerText = 'Chyba při dekódování audia.'; }
 };
 reader.readAsArrayBuffer(file);
 }

 function extractWaveformPeaks(buffer) {
 const data = buffer.getChannelData(0), count = 800, step = Math.floor(data.length / count);
 rawPcmData = new Float32Array(count);
 for (let i = 0; i < count; i++) {
 let max = 0, start = i * step;
 for (let j = 0; j < step; j += 10) max = Math.max(max, Math.abs(data[start + j] || 0));
 rawPcmData[i] = max;
 }
 }

 function setupAudioEventListeners() {
 audioPlayer.addEventListener('timeupdate', () => {
 document.getElementById('time-current').innerText = formatFormattedTime(audioPlayer.currentTime);
 drawWaveform(); highlightCurrentTranscriptRow();
 });
 const setPlayIcon = paused => {
 document.getElementById('icon-play').classList.toggle('hidden', !paused);
 document.getElementById('icon-pause').classList.toggle('hidden', paused);
 };
 ['play', 'pause', 'ended'].forEach(ev => audioPlayer.addEventListener(ev, () => setPlayIcon(audioPlayer.paused)));
 }

 function togglePlay() { if (audioPlayer.src) audioPlayer.paused ? audioPlayer.play() : audioPlayer.pause(); }
 function pausePlayback() { if (audioPlayer && !audioPlayer.paused) audioPlayer.pause(); }
 function seekRelative(s) { if (audioPlayer.src) audioPlayer.currentTime = Math.max(0, Math.min(audioPlayer.duration || 0, audioPlayer.currentTime + s)); }
 function seekToTime(s) {
 if (!audioPlayer.src) return;
 if (s > 900000 && audioBuffer) s = audioBuffer.duration;
 audioPlayer.currentTime = s; audioPlayer.play();
 }
 function changeSpeed(v) { if (audioPlayer) audioPlayer.playbackRate = parseFloat(v); }

 function drawWaveform() {
 const canvas = document.getElementById('waveform-canvas');
 if (!canvas) return;
 const ctx = canvas.getContext('2d'), width = canvas.clientWidth, height = canvas.clientHeight;
 if (canvas.width !== width || canvas.height !== height) { canvas.width = width; canvas.height = height; }
 ctx.clearRect(0, 0, width, height);

 ctx.strokeStyle = '#1E293B'; ctx.lineWidth = 1;
 for (let x = 0; x < width; x += 60) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, height); ctx.stroke(); }

 const duration = audioBuffer?.duration || audioPlayer?.duration || 0;
 if (!rawPcmData) {
 ctx.fillStyle = '#475569'; ctx.font = '12px Inter, sans-serif'; ctx.textAlign = 'center';
 ctx.fillText('Nahrajte audio soubor pro zobrazení zvukové vlny', width / 2, height / 2);
 return;
 }

 if (duration > 0) {
 userMarkers.forEach(m => {
 if (m.type === 'cut') {
 const xIn = (m.timeInSeconds / duration) * width;
 const xOut = m.timeOutSeconds ? (m.timeOutSeconds / duration) * width : xIn + 4;
 ctx.fillStyle = 'rgba(245, 158, 11, 0.25)'; ctx.fillRect(xIn, 0, Math.max(2, xOut - xIn), height);
 ctx.strokeStyle = '#F59E0B'; ctx.lineWidth = 1.5; ctx.setLineDash([4, 2]);
 ctx.beginPath(); ctx.moveTo(xIn, 0); ctx.lineTo(xIn, height); ctx.moveTo(xOut, 0); ctx.lineTo(xOut, height); ctx.stroke(); ctx.setLineDash([]);
 }
 });
 }

 const barW = width / rawPcmData.length, curX = duration > 0 ? (audioPlayer.currentTime / duration) * width : 0;
 for (let i = 0; i < rawPcmData.length; i++) {
 const x = i * barW, barH = Math.max(2, rawPcmData[i] * (height - 10));
 ctx.fillStyle = x <= curX ? '#06B6D4' : '#475569';
 ctx.fillRect(x, (height - barH) / 2, barW - 0.5, barH);
 }

 if (duration > 0) {
 userMarkers.forEach(m => {
 if (m.type === 'jingle' || m.type === 'note') {
 const x = ((m.timeInSeconds > 900000 ? duration : m.timeInSeconds) / duration) * width;
 const col = m.type === 'jingle' ? '#10B981' : '#8B5CF6';
 ctx.strokeStyle = col; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, height); ctx.stroke();
 ctx.fillStyle = col; ctx.beginPath(); ctx.moveTo(x - 4, 0); ctx.lineTo(x + 4, 0); ctx.lineTo(x, 8); ctx.fill();
 }
 });

 if (pendingCutIn !== null) {
 const pX = (pendingCutIn / duration) * width;
 ctx.strokeStyle = '#F59E0B'; ctx.lineWidth = 2.5; ctx.beginPath(); ctx.moveTo(pX, 0); ctx.lineTo(pX, height); ctx.stroke();
 ctx.fillStyle = '#F59E0B'; ctx.font = '10px Inter, sans-serif'; ctx.fillText('IN', pX + 3, 12);
 }

 ctx.strokeStyle = '#FFFFFF'; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(curX, 0); ctx.lineTo(curX, height); ctx.stroke();
 }
 }

 function handleCanvasClick(e) {
 const rect = e.currentTarget.getBoundingClientRect(), dur = audioBuffer?.duration || audioPlayer.duration;
 if (dur > 0) seekToTime(((e.clientX - rect.left) / rect.width) * dur);
 }

 function updateAiEstimate() {
 const durEl = document.getElementById('est-duration-text'), finEl = document.getElementById('est-finish-text');
 if (!durEl || !finEl) return;
 if (!audioBuffer) { durEl.innerText = 'Vyžaduje načtené audio'; finEl.innerText = 'Hotovo: —'; return; }

 const model = document.getElementById('ai-model-select').value, dev = document.getElementById('ai-device-select').value;
 let rtf = model.includes('tiny') ? 0.20 : model.includes('base') ? 438 / 1800 : 0.70;
 if (dev === 'wasm') rtf *= 2.5;

 const totalSec = Math.round(audioBuffer.duration * rtf);
 const fin = new Date(Date.now() + totalSec * 1000);
 const m = Math.floor(totalSec / 60), s = totalSec % 60;

 durEl.innerText = m > 0 ? `cca ${m} min ${s} s` : `cca ${s} s`;
 finEl.innerText = `Hotovo cca v ${String(fin.getHours()).padStart(2, '0')}:${String(fin.getMinutes()).padStart(2, '0')}`;
 }

 function getMonoPcm(buf) {
 const len = buf.length, pcm = new Float32Array(len);
 if (buf.numberOfChannels === 1) pcm.set(buf.getChannelData(0));
 else {
 const l = buf.getChannelData(0), r = buf.getChannelData(1);
 for (let i = 0; i < len; i++) pcm[i] = (l[i] + r[i]) / 2;
 }
 return pcm;
 }

 async function runAiTranscription() {
 if (!audioBuffer) return showToast('Nejprve prosím nahrajte audio soubor.');
 pausePlayback(); updateAiEstimate();

 if ('wakeLock' in navigator) { try { wakeLockObj = await navigator.wakeLock.request('screen'); } catch (e) {} }

 const modelName = document.getElementById('ai-model-select').value, deviceChoice = document.getElementById('ai-device-select').value;
 const customPrompt = (document.getElementById('ai-prompt-input').value || '').trim();
 const progContainer = document.getElementById('ai-progress-container'), statusText = document.getElementById('ai-status-text');
 const statusPct = document.getElementById('ai-status-percent'), progBar = document.getElementById('ai-progress-bar');
 const btnStart = document.getElementById('btn-start-ai'), timerEl = document.getElementById('ai-timer');

 progContainer.classList.remove('hidden'); btnStart.disabled = true; btnStart.classList.add('opacity-50');

 clearInterval(aiTimerInterval);
 const aiStart = Date.now();
 timerEl.innerText = '00:00';
 aiTimerInterval = setInterval(() => {
 const el = Math.floor((Date.now() - aiStart) / 1000);
 timerEl.innerText = `${String(Math.floor(el / 60)).padStart(2, '0')}:${String(el % 60).padStart(2, '0')}`;
 }, 1000);

 const updateProgress = (txt, pct) => { statusText.innerText = txt; statusPct.innerText = `${pct}%`; progBar.style.width = `${pct}%`; };
 updateProgress('Příprava výpočtu na pozadí...', 5);
 const monoPcm = getMonoPcm(audioBuffer);

 const workerCode = `
 import { pipeline, env } from 'https://cdn.jsdelivr.net/npm/@xenova/transformers@2.17.2';
 env.allowLocalModels = false; env.useBrowserCache = true;
 self.onmessage = async (e) => {
 const { monoPcm, oldSampleRate, modelName, langSelection, customPrompt, deviceChoice } = e.data;
 try {
 const targetSampleRate = 16000, newLength = Math.round(monoPcm.length * (targetSampleRate / oldSampleRate));
 const pcm16k = new Float32Array(newLength), ratio = oldSampleRate / targetSampleRate, chunkSize = 100000;
 for (let i = 0; i < newLength; i += chunkSize) {
 const end = Math.min(i + chunkSize, newLength);
 for (let j = i; j < end; j++) {
 const orig = j * ratio, idxFloor = Math.floor(orig), idxCeil = Math.min(monoPcm.length - 1, idxFloor + 1);
 pcm16k[j] = monoPcm[idxFloor] + (orig - idxFloor) * (monoPcm[idxCeil] - monoPcm[idxFloor]);
 }
 self.postMessage({ type: 'progress', text: 'Příprava zvukového signálu (16kHz)...', pct: Math.min(85, Math.round((i / newLength) * 85)) });
 }
 let dev = 'wasm';
 if (deviceChoice === 'auto' && navigator.gpu && await navigator.gpu.requestAdapter()) dev = 'webgpu';
 const devLabel = dev === 'webgpu' ? 'WebGPU' : 'CPU';
 self.postMessage({ type: 'progress', text: 'Načítání AI modelu (' + devLabel + ')...', pct: 88 });
 const transcriber = await pipeline('automatic-speech-recognition', modelName, {
 device: dev,
 progress_callback: (p) => {
 if (p.status === 'progress' && p.total) self.postMessage({ type: 'progress', text: 'Stahování AI modelu...', pct: Math.min(92, 85 + Math.round((p.loaded / p.total) * 7)) });
 }
 });
 self.postMessage({ type: 'progress', text: 'Probíhá přepis mluveného slova (' + devLabel + ')...', pct: 95 });
 const opts = { chunk_length_s: 30, stride_length_s: 5, language: langSelection, task: 'transcribe', return_timestamps: true };
 if (customPrompt) opts.initial_prompt = customPrompt;
 const result = await transcriber(pcm16k, opts);
 self.postMessage({ type: 'complete', result });
 } catch (err) { self.postMessage({ type: 'error', message: err.message || String(err) }); }
 };`;

 const worker = new Worker(URL.createObjectURL(new Blob([workerCode], { type: 'application/javascript' })), { type: 'module' });
 worker.onmessage = (e) => {
 const { type, text, pct, result, message } = e.data;
 if (type === 'progress') updateProgress(text, pct);
 else if (type === 'complete') {
 transcriptSegments = result?.chunks ? result.chunks.map(c => ({ start: c.timestamp[0] ?? 0, end: c.timestamp[1] ?? 0, text: (c.text || '').trim() })) : [{ start: 0, end: audioBuffer.duration, text: result.text.trim() }];
 updateProgress('Přepis dokončen!', 100); saveStateToStorage(); renderTable(); showToast('AI přepis byl úspěšně vygenerován!'); cleanupWorker(worker);
 } else { showToast('Chyba přepisu: ' + message); cleanupWorker(worker); }
 };
 worker.onerror = () => { showToast('Chyba ve výpočetním vlákně AI.'); cleanupWorker(worker); };
 worker.postMessage({ monoPcm, oldSampleRate: audioBuffer.sampleRate, modelName, langSelection: 'czech', customPrompt, deviceChoice }, [monoPcm.buffer]);

 function cleanupWorker(w) {
 w.terminate(); clearInterval(aiTimerInterval); aiTimerInterval = null;
 wakeLockObj?.release(); wakeLockObj = null;
 btnStart.disabled = false; btnStart.classList.remove('opacity-50');
 setTimeout(() => progContainer.classList.add('hidden'), 3000);
 }
 }

 function getSpeechInTimeRange(sIn, sOut) {
 if (!transcriptSegments.length) return '';
 const effEnd = (sOut && sOut > sIn) ? sOut : sIn + 3;
 return transcriptSegments.filter(s => s.start <= effEnd && s.end >= sIn).map(m => m.text).join(' ');
 }

 function handleCutButtonClick() {
 pausePlayback();
 const cur = audioPlayer?.currentTime || 0;
 if (pendingCutIn === null) {
 pendingCutIn = cur; updateCutPendingBanner(); showToast(`Začátek střihu označen v ${formatFormattedTime(pendingCutIn)}`); drawWaveform();
 } else confirmCut();
 }

 function updateCutPendingBanner() {
 const banner = document.getElementById('cut-pending-banner');
 banner.classList.toggle('hidden', pendingCutIn === null);
 if (pendingCutIn !== null) document.getElementById('pending-in-time').innerText = formatFormattedTime(pendingCutIn);
 }

 function confirmCut() {
 pausePlayback();
 if (pendingCutIn === null) return;
 const cur = audioPlayer?.currentTime || pendingCutIn + 2;
 openItemModal('cut', { timeIn: formatFormattedTime(Math.min(pendingCutIn, cur)), timeOut: formatFormattedTime(Math.max(pendingCutIn, cur)), category: 'Střih / Vymazat úsek', instruction: 'Vymazat přeřeknutí a ticho' });
 }

 function cancelPendingCut() { pendingCutIn = null; updateCutPendingBanner(); drawWaveform(); showToast('Označování střihu zrušeno.'); }
 function openJingleModal() { pausePlayback(); openItemModal('jingle', { timeIn: formatFormattedTime(audioPlayer?.currentTime || 0), timeOut: '', category: 'Úvodní znělka / Intro', instruction: 'Vložit znělku' }); }
 function openNoteModal() { pausePlayback(); openItemModal('note', { timeIn: formatFormattedTime(audioPlayer?.currentTime || 0), timeOut: '', category: 'Přeřeknutí / Opakování', instruction: 'Opravit mluvený úsek' }); }

 function openItemModal(type, defaults = {}, isEditId = null) {
 pausePlayback();
 document.getElementById('form-item-id').value = isEditId || '';
 document.getElementById('form-item-type').value = type;
 document.getElementById('form-time-in').value = defaults.timeIn || '00:00:00';
 document.getElementById('form-time-out').value = defaults.timeOut || '';
 document.getElementById('form-instruction').value = defaults.instruction || '';

 const cats = type === 'cut' ? ['Střih / Vymazat úsek', 'Highlight / Zajímavý moment', 'Vymazat pauzu / Ticho', 'Odstranit přeřeknutí', 'Ostatní střih'] :
 type === 'jingle' ? ['Úvodní znělka / Intro', 'Highlighty loop', 'Závěrečná znělka / Outro', 'jingle_short', 'Pozvánka/Reklama'] :
 ['Trigger warning', 'Přeřeknutí / Opakování', 'Šum / Ruch / Pleskání', 'Úprava hlasitosti', 'Ostatní instrukce'];

 document.getElementById('modal-title').innerText = `${isEditId ? 'Upravit' : 'Vložit'} ${type === 'cut' ? 'střih' : type === 'jingle' ? 'znělku' : 'poznámku'}`;
 renderCategoryButtons(cats, defaults.category || cats[0]);
 updateModalSpeechPreview();
 document.getElementById('modal-item').classList.remove('hidden');
 }

 function renderCategoryButtons(categories, selected) {
 const container = document.getElementById('category-buttons-container');
 document.getElementById('form-category').value = selected;
 container.innerHTML = '';
 const activeClass = 'px-2.5 py-1.5 bg-studio-accent text-slate-950 font-bold text-xs rounded-lg border border-cyan-300 transition shadow';
 const inactiveClass = 'px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs rounded-lg border border-slate-700 transition';
 categories.forEach(cat => {
