 function editItem(id) { const item = userMarkers.find(m => m.id === id); if (item) openItemModal(item.type, item, item.id); }
 function deleteItem(id) { userMarkers = userMarkers.filter(m => m.id !== id); saveStateToStorage(); renderTable(); drawWaveform(); showToast('Položka byla smazána.'); }

 function setFilter(f) {
 activeFilter = f;
 ['all', 'cut', 'jingle', 'note'].forEach(filter => {
