 }

 function handleSearch(v) { searchQuery = (v || '').toLowerCase(); renderTable(); }

 function renderTable() {
 const tbody = document.getElementById('protocol-table-body'), emptyMsg = document.getElementById('empty-table-msg');
 tbody.innerHTML = '';

