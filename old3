 return item.instruction?.toLowerCase().includes(searchQuery) || item.category?.toLowerCase().includes(searchQuery) || speech.includes(searchQuery);
 });

 filtered.sort((a, b) => (a.orderPriority || 500) - (b.orderPriority || 500) || (a.timeInSeconds || 0) - (b.timeInSeconds || 0));
 document.getElementById('items-count').innerText = filtered.length;

